# Server Port
PORT=3001
JWT_SECRET=your-secure-jwt-secret-key
SYNC_INTERVAL_MINUTES=60
NODE_TLS_REJECT_UNAUTHORIZED=0

# Enable Local Mock Engine for offline development without Jira Server connection
ENABLE_LOCAL_MOCK=false

# Jira Server Connection Configuration
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_USERNAME=your_jira_username
JIRA_TOKEN=your_jira_personal_access_token_or_password
JIRA_PROJECT_KEY=ORD, OPS
JIRA_WAITING_STATUSES=OnHolding,Waiting,On Hold,Wait,Pending,Blocked
JIRA_REBUILD_MONTHS=12

# Confluence Connection Configuration (Optional)
CONFLUENCE_BASE_URL=https://jira.yourcompany.com/wiki
CONFLUENCE_USERNAME=your_confluence_username
CONFLUENCE_TOKEN=your_confluence_token
CONFLUENCE_DEFAULT_SPACE=OPS

# Jira Custom Field IDs Mapping
JIRA_SPRINT_FIELD=customfield_10020
JIRA_EPIC_LINK_FIELD=customfield_10006
JIRA_WAITING_TEAM_FIELD=customfield_16800
JIRA_WAITING_REASON_FIELD=
JIRA_CONFLUENCE_LINK_FIELD=
JIRA_CAPABILITIES_FIELD=
JIRA_CATEGORY_FIELD=

# Date Fields Mapping (created, duedate, or customfield_xxxxx)
JIRA_EPIC_START_DATE_FIELD=created
JIRA_EPIC_DUE_DATE_FIELD=duedate
JIRA_TASK_START_DATE_FIELD=
JIRA_TASK_DUE_DATE_FIELD=duedate

# Label Prefixes
JIRA_WAIT_TEAM_PREFIX=wait:
JIRA_WAIT_REASON_PREFIX=reason:
JIRA_CAPABILITY_PREFIX=cap:
JIRA_FEATURED_COMPONENTS=learning,meeting,support,infrastructure
